<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
      <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
        <t t-if="env.services.pos.config.l10n_do_fiscal_journal">
            <button class="button btn btn-light py-3 text-start rounded-0 border-bottom" style="color:red" t-on-click="onClick">
                <li class="info">
                    <i class="fa fa-edit" role="img" aria-label="Set Type position" title="Set fiscal Type"/>
                    <t t-esc="currentFiscalTypeName"/>
                </li>
            </button>
        </t>
      </xpath>
  </t>
</templates>
