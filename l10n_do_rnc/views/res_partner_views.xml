<odoo>

    <!-- VIEWS: "Res Parter"

        - Model·········: res_partner
        - Base Addons···: contacts    
    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <!-- Form view for "res_partner" -->
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@id='company']" position="replace">
                <field id="company" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Lumber Inc" invisible="country_id == %(base.do)s or not is_company" required="type == 'contact'"/>
                <field id="company" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Lumber Inc or RNC e.g. NNNNNNNNN" invisible="country_id != %(base.do)s or not is_company" required="type == 'contact'"/>
            </xpath>
            <xpath expr="//field[@id='individual']" position="replace">
                <field id="individual" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandom Freeman" invisible="country_id == %(base.do)s or is_company" required="type == 'contact'"/>
                <field id="individual" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandom Freeman or Cedula e.g. NNNNNNNNNNN" invisible="country_id != %(base.do)s or is_company" required="type == 'contact'"/>
            </xpath>
        </field>
    </record>


</odoo>